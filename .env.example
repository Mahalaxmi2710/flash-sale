
# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info
# Set LOG_ACCESS=false during load tests (per-request logs are expensive)
LOG_ACCESS=true
HTTP_PORT=8080

# --- Product / sale ---
PRODUCT_ID=phone-x
PRODUCT_NAME=Phoenix X Smartphone
PRODUCT_PRICE_CENTS=49900
SALE_STOCK=500
SALE_START_DELAY_SECONDS=60
# Optional fixed start time (ISO-8601 with offset). Overrides the delay above.
# SALE_START_AT=2026-11-01T10:00:00+05:30
RESERVATION_TTL_SECONDS=30

# --- Security ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# --- PostgreSQL (use URL-safe passwords) ---
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash_pw
POSTGRES_DB=flashsale
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ (used from Batch 2; started now) ---
RABBITMQ_USER=flash
RABBITMQ_PASSWORD=flash_pw
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- NGINX per-IP rate limits (optional; defaults are in docker-compose.yaml) ---
# Defaults protect the site from one abusive client. For k6/simulate runs from ONE machine, raise them:
# NGINX_RATE_CHECKOUT=100000r/s
# NGINX_RATE_STATUS=100000r/s
# NGINX_RATE_API=100000r/s
# NGINX_BURST_CHECKOUT=100000
# NGINX_BURST_STATUS=100000
# NGINX_BURST_API=100000
# NGINX_MAX_CONN_PER_IP=100000

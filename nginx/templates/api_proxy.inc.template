# Shared by every /api location. Rendered to /etc/nginx/conf.d/api_proxy.inc at container start.
proxy_pass http://api_upstream;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append: clients cannot spoof it
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Request-Id $request_id;
proxy_connect_timeout 2s;
proxy_send_timeout 10s;
proxy_read_timeout 10s;
# Safe retries only: GETs (and connection failures before the request was sent) move to another replica.
# A POST that reached a replica is never replayed by NGINX; the client retries it with its Idempotency-Key.
proxy_next_upstream error timeout http_502 http_503;
proxy_next_upstream_tries 2;
proxy_next_upstream_timeout 3s;
